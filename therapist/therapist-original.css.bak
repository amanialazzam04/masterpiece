/* Therapist-specific layouts extend the approved Family Portal design system. */
.therapist-layout { min-height: 100vh; }
.therapist-container { display: grid; align-content: start; gap: 0; }
.th-demo-banner { margin: 0 0 17px; padding: 12px 15px; border: 1px solid #d7eaf1; border-radius: 12px; background: linear-gradient(110deg, #f1faff, #f1fbf8); color: #58768a; font-size: 11px; }
.th-demo-banner strong { color: var(--navy); }
.th-stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; margin-bottom: 17px; }
.th-stat-card { position: relative; min-width: 0; padding: 18px 17px; border: 1px solid var(--border); border-radius: 16px; background: #fff; box-shadow: 0 6px 22px rgba(11,69,109,.04); }
.th-stat-icon { display: grid; width: 34px; height: 34px; margin-bottom: 12px; place-items: center; border-radius: 11px; background: #e8f7fb; color: var(--teal); font-size: 19px; }
.th-stat-card p { color: var(--muted); font-size: 11px; font-weight: 600; }
.th-stat-card>strong { display: block; margin-top: 2px; color: var(--navy); font: 800 25px/1.25 "Manrope", sans-serif; }
.th-stat-card small { color: #8a9eab; font-size: 9px; }
.th-dashboard-grid { margin-top: 0; }
.th-compact-list { display: grid; gap: 9px; margin-bottom: 13px; }
.th-compact-item { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; padding: 10px 11px; border: 1px solid #e7f0f4; border-radius: 11px; background: #fbfdfe; }
.th-compact-date { display: grid; min-width: 48px; min-height: 44px; place-content: center; border-radius: 10px; background: #eaf7fa; color: var(--blue); font-size: 9px; font-weight: 800; line-height: 1.35; text-align: center; }
.th-compact-item strong, .th-compact-item small { display: block; }
.th-compact-item strong { color: var(--navy); font-size: 11px; }
.th-compact-item small { color: var(--muted); font-size: 9px; }
.th-inline-link { min-height: 36px; margin-top: 2px; }
.th-shortcut-section { margin-top: 23px; }
.th-shortcut-section .section-heading { margin-bottom: 12px; }
.th-shortcut-section .section-heading h2 { color: var(--navy); font: 700 19px "Manrope", sans-serif; }
.th-shortcut-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.th-shortcut { display: grid; gap: 4px; padding: 16px; border: 1px solid var(--border); border-radius: 15px; background: #fff; box-shadow: 0 5px 17px rgba(11,69,109,.035); transition: border-color .2s, transform .2s, box-shadow .2s; }
.th-shortcut:hover { transform: translateY(-2px); border-color: #b5e3ed; box-shadow: var(--shadow); }
.th-shortcut>span { color: var(--teal); font-size: 22px; }
.th-shortcut strong { color: var(--navy); font: 700 12px "Manrope", sans-serif; }
.th-shortcut small { color: var(--muted); font-size: 10px; }
.th-toolbar { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(180px, .45fr); gap: 13px; margin-bottom: 15px; }
.th-search-field input { width: 100%; min-height: 43px; padding: 9px 11px; border: 1px solid #d6e7ef; border-radius: 10px; background: #fff; color: var(--text); font-size: 12px; }
.th-client-list, .th-session-list, .th-request-list, .th-task-list, .th-note-list { display: grid; gap: 11px; }
.th-client-card, .th-session-card, .th-request-card, .th-task-card, .th-note-card { min-width: 0; padding: 16px; border: 1px solid var(--border); border-radius: 15px; background: #fff; box-shadow: 0 5px 18px rgba(11,69,109,.035); }
.th-card-topline { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 10px; }
.th-card-topline h2, .th-card-topline h3 { color: var(--navy); font: 700 14px "Manrope", sans-serif; }
.th-card-topline p, .th-card-copy { margin-top: 5px; color: var(--muted); font-size: 11px; }
.th-client-meta { display: flex; flex-wrap: wrap; gap: 7px 16px; margin: 11px 0; color: #607b8c; font-size: 10px; }
.th-card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; }
.th-card-actions .primary-button, .th-card-actions .secondary-button { min-height: 36px; padding: 7px 12px; font-size: 10px; }
.th-status { display: inline-flex; align-items: center; padding: 5px 9px; border-radius: 999px; background: #eaf7f2; color: #34866e; font-size: 9px; font-weight: 800; }
.th-status.pending { background: #fff5e9; color: #a76a31; }
.th-status.completed { background: #eaf7f2; color: #34866e; }
.th-status.cancelled, .th-status.declined { background: #f5eff0; color: #8c6470; }
.th-status.proposal { background: #edf3fc; color: #5775a1; }
.th-client-detail { display: grid; gap: 14px; }
.th-detail-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; margin-top: 13px; }
.th-detail-facts p { display: grid; gap: 3px; padding: 11px; border-radius: 10px; background: #f5fafc; }
.th-detail-facts span { color: var(--muted); font-size: 9px; }
.th-detail-facts strong { color: var(--navy); font-size: 11px; }
.th-goal-list { display: grid; gap: 8px; padding-left: 18px; color: var(--text); font-size: 11px; }
.th-subheading { margin-top: 16px; color: var(--navy); font: 700 12px "Manrope", sans-serif; }
.th-reading-copy { color: #557286; font-size: 11px; }
.th-history-list { display: grid; gap: 8px; }
.th-history-item { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 7px 16px; padding: 11px 12px; border: 1px solid #e7f0f4; border-radius: 11px; color: var(--muted); font-size: 10px; }
.th-history-item strong { color: var(--navy); }
.th-empty-state { margin-top: 12px; }
.th-session-card { display: grid; grid-template-columns: minmax(110px, .32fr) 1fr; gap: 13px; }
.th-session-time { padding: 11px; border-radius: 11px; background: #f0f9fb; color: var(--blue); font-size: 10px; font-weight: 800; }
.th-session-time strong, .th-session-time span { display: block; }
.th-session-time span { margin-top: 3px; color: var(--muted); font-size: 9px; font-weight: 500; }
.th-proposal-form { display: flex; flex-wrap: wrap; align-items: end; gap: 9px; margin-top: 12px; padding: 12px; border-radius: 11px; background: #f6fbfd; }
.th-proposal-form label { display: grid; gap: 4px; color: var(--navy); font-size: 10px; font-weight: 700; }
.th-proposal-form input { min-height: 36px; padding: 6px 9px; border: 1px solid #d6e7ef; border-radius: 8px; background: #fff; color: var(--text); font-size: 11px; }
.th-proposal-feedback { flex-basis: 100%; color: #34866e; font-size: 10px; }
.th-privacy-panel { margin-bottom: 16px; }
.th-availability { min-width: 0; padding: 0; border: 0; }
.th-checkbox-row { display: flex; flex-wrap: wrap; gap: 8px 17px; }
.th-checkbox-row label { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 11px; font-weight: 500; }
.th-checkbox-row input { accent-color: var(--teal); }
.th-task-priority { color: #a76a31; font-size: 9px; font-weight: 800; }
.th-report-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 14px; }
.th-progress-row { display: grid; grid-template-columns: minmax(170px, .65fr) 1fr auto; align-items: center; gap: 13px; }
.th-progress-row>div:first-child { display: grid; gap: 3px; }
.th-progress-row strong { color: var(--navy); font-size: 11px; }
.th-progress-row span { color: var(--muted); font-size: 9px; }
.th-progress-track { height: 12px; overflow: hidden; border-radius: 99px; background: #e7f1f5; }
.th-progress-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #65c6cf, #0b91ad); }
.th-chart { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); align-items: end; gap: 10px; height: 175px; margin: 17px 0 8px; padding: 13px 12px 0; border-bottom: 1px solid var(--border); background: repeating-linear-gradient(to bottom, transparent 0, transparent 39px, #edf4f7 40px); }
.th-chart-column { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: flex-end; gap: 5px; color: var(--muted); font-size: 9px; }
.th-chart-column>span { width: min(28px, 62%); min-height: 8px; border-radius: 7px 7px 2px 2px; background: linear-gradient(180deg, #59bfcb, #0b91ad); }
.th-chart-column>b { color: var(--navy); font-size: 9px; }
.th-chart-column>small { padding-bottom: 5px; }
.th-empty-report { margin-top: 13px; }
.therapist-container .field-hint { line-height: 1.6; }
.therapist-container input:focus-visible, .therapist-container select:focus-visible, .therapist-container textarea:focus-visible { outline: 3px solid #79cfe2; outline-offset: 2px; }

@media (max-width: 960px) {
  .th-stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .th-report-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .th-shortcut-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  .th-stat-grid, .th-report-stats, .th-shortcut-grid, .th-toolbar, .th-detail-facts { grid-template-columns: 1fr; }
  .th-stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .th-report-stats { grid-template-columns: 1fr; }
  .th-shortcut-grid { grid-template-columns: 1fr; }
  .th-toolbar { gap: 10px; }
  .th-session-card { grid-template-columns: 1fr; }
  .th-session-time { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5px 12px; }
  .th-session-time span { margin-top: 0; }
  .th-progress-row { grid-template-columns: 1fr auto; }
  .th-progress-row .th-progress-track { grid-row: 2; grid-column: 1 / -1; }
  .th-chart { gap: 5px; padding-inline: 3px; }
  .th-chart-column { font-size: 8px; }
  .th-card-actions { align-items: stretch; }
}
@media (prefers-reduced-motion: reduce) {
  .th-shortcut, .th-compact-item { transition: none; }
}
