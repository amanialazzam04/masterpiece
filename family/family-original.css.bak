:root {
  --navy: #075985;
  --blue: #0369a1;
  --teal: #0891a8;
  --sky: #e0f2fe;
  --pale: #f0f9ff;
  --white: #fff;
  --text: #29475b;
  --muted: #668195;
  --border: #dcecf5;
  --shadow: 0 16px 42px rgba(11, 69, 109, .12);
  --sidebar-width: 263px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { min-height: 100%; scroll-behavior: smooth; }
body { min-height: 100vh; overflow-x: hidden; background: #f5fbff; color: var(--text); font: 14px/1.65 "DM Sans", "Segoe UI", Arial, sans-serif; }
a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #79cfe2; outline-offset: 3px; }
h1[tabindex="-1"]:focus-visible { outline: 2px solid #79cfe2; outline-offset: 5px; }
[hidden] { display: none !important; }

.family-layout { min-height: 100vh; }
.sidebar { position: fixed; inset: 0 auto 0 0; z-index: 100; display: flex; width: var(--sidebar-width); flex-direction: column; padding: 25px 14px 18px; overflow-y: auto; border-right: 1px solid var(--border); background: #fff; }
.logo { display: flex; width: fit-content; align-items: center; margin: 0 0 25px 8px; }
.logo-image { display: block; width: 175px; height: 72px; object-fit: contain; object-position: left center; }
.sidebar-label { margin: 0 0 12px 12px; color: #7895a9; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; }
.sidebar-nav { display: grid; gap: 5px; }
.nav-link { display: flex; min-height: 45px; align-items: center; gap: 11px; padding: 0 11px; border: 1px solid transparent; border-radius: 11px; color: #52718a; font-size: 12px; font-weight: 600; transition: background .2s ease, color .2s ease, border-color .2s ease; }
.nav-link:hover { background: #f0f9ff; color: var(--blue); }
.nav-link.active { border-color: #d5ecf9; background: #e8f6ff; color: var(--navy); box-shadow: inset 3px 0 var(--blue); }
.nav-icon { display: grid; width: 25px; height: 25px; flex: 0 0 25px; place-items: center; color: var(--teal); font-size: 19px; }
.sidebar-bottom { margin-top: auto; padding-top: 20px; }
.help-card { padding: 15px 13px; border: 1px solid #d7edf5; border-radius: 15px; background: linear-gradient(145deg, #f2fbff, #e6f8f7); }
.help-icon { display: grid; width: 33px; height: 33px; margin-bottom: 9px; place-items: center; border-radius: 11px; background: white; color: var(--teal); font-size: 20px; }
.help-card h3 { margin-bottom: 5px; color: var(--navy); font: 700 13px "Manrope", sans-serif; }
.help-card p { margin-bottom: 10px; color: var(--muted); font-size: 11px; line-height: 1.65; }
.view-link { display: flex; align-items: center; justify-content: space-between; color: var(--blue); font-size: 11px; font-weight: 800; }
.view-link span { transition: transform .2s; }
.view-link:hover span { transform: translateX(4px); }
.logout-link { display: flex; min-height: 44px; align-items: center; gap: 10px; margin-top: 10px; padding: 0 9px; border-radius: 9px; color: #627c8d; font-size: 12px; font-weight: 700; transition: background .2s, color .2s; }
.logout-link:hover { background: #eef8fc; color: var(--blue); }
.logout-link .nav-icon { font-size: 17px; }
.sidebar-overlay { display: none; }

.main-content { min-width: 0; min-height: 100vh; margin-left: var(--sidebar-width); }
.topbar { position: sticky; top: 0; z-index: 50; display: flex; min-height: 72px; align-items: center; justify-content: space-between; gap: 16px; padding: 0 32px; border-bottom: 1px solid var(--border); background: rgba(255,255,255,.94); backdrop-filter: blur(12px); }
.breadcrumb { display: flex; min-width: 0; align-items: center; gap: 10px; color: var(--muted); font-size: 12px; }
.breadcrumb strong { overflow: hidden; color: var(--navy); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.breadcrumb-separator { color: #a4bac8; }
.topbar-actions { display: flex; align-items: center; gap: 10px; }
.portal-badge, .demo-status { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--border); border-radius: 999px; background: #fff; color: var(--blue); font-size: 10px; font-weight: 800; white-space: nowrap; }
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: #39a98c; box-shadow: 0 0 0 4px #e5f7f1; }
.muted-dot { background: #aabcc7; box-shadow: 0 0 0 4px #edf3f6; }
.menu-button { display: none; width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 12px; background: #fff; color: var(--navy); font-size: 20px; cursor: pointer; }
.portal-container { width: min(1320px, 100%); margin: 0 auto; padding: 30px clamp(22px, 4vw, 52px) 35px; }
.portal-view { animation: view-enter .3s ease both; }
@keyframes view-enter { from { opacity: .55; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
.page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin: 0 0 23px; }
.eyebrow { margin-bottom: 7px; color: var(--teal); font-size: 10px; font-weight: 800; letter-spacing: 1.6px; }
h1, h2, h3 { color: var(--navy); }
.page-heading h1 { font: 700 clamp(25px, 3vw, 35px)/1.2 "Manrope", sans-serif; letter-spacing: -.8px; }
.page-description { max-width: 690px; margin-top: 9px; color: var(--muted); font-size: 14px; }
.welcome-card { position: relative; display: flex; min-height: 220px; align-items: center; justify-content: space-between; gap: 26px; overflow: hidden; padding: clamp(25px, 4vw, 42px); border: 1px solid #d5edf6; border-radius: 22px; background: linear-gradient(115deg, #e7f7fc, #f9fdff 68%, #def3f8); box-shadow: 0 10px 30px rgba(11,69,109,.07); }
.welcome-copy { position: relative; z-index: 1; max-width: 690px; }
.welcome-card h2 { margin-bottom: 9px; font: 700 clamp(22px, 2.4vw, 29px)/1.2 "Manrope", sans-serif; letter-spacing: -.4px; }
.welcome-card p:not(.eyebrow) { max-width: 620px; margin-bottom: 17px; color: #52728a; font-size: 13px; }
.welcome-art { position: relative; display: grid; width: 130px; height: 130px; flex: 0 0 130px; place-items: center; }
.welcome-orb { z-index: 1; display: grid; width: 83px; height: 83px; place-items: center; border: 1px solid rgba(8,145,168,.16); border-radius: 50%; background: rgba(255,255,255,.83); color: var(--teal); font-size: 43px; box-shadow: 0 12px 32px rgba(11,69,109,.1); animation: gentle-float 5s ease-in-out infinite; }
.welcome-ring { position: absolute; inset: 0; border: 1px solid rgba(8,145,168,.22); border-radius: 50%; }
@keyframes gentle-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
.connection-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
.summary-card { display: flex; min-height: 108px; flex-direction: column; justify-content: center; gap: 4px; padding: 15px; border: 1px solid var(--border); border-radius: 15px; background: #fff; box-shadow: 0 6px 20px rgba(11,69,109,.035); }
.summary-label { color: #7895a9; font-size: 9px; font-weight: 800; letter-spacing: 1px; }
.summary-card strong { color: var(--navy); font: 800 22px "Manrope", sans-serif; }
.summary-card>span:last-child { color: var(--muted); font-size: 10px; }
.summary-card .summary-status { font-size: 15px; }
.summary-action { transition: transform .2s, box-shadow .2s; }
.summary-action:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
.next-steps-section { margin-top: 24px; }
.section-heading { margin-bottom: 12px; }
.section-heading h2 { color: var(--navy); font: 700 19px "Manrope", sans-serif; }
.next-step-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.next-step-card { display: grid; align-content: start; gap: 6px; min-height: 113px; padding: 15px; border: 1px solid var(--border); border-radius: 15px; background: #fff; box-shadow: 0 6px 20px rgba(11,69,109,.035); transition: transform .2s, border-color .2s, box-shadow .2s; }
.next-step-card:hover { transform: translateY(-3px); border-color: #b5e6f5; box-shadow: var(--shadow); }
.next-step-card strong { color: var(--navy); font: 700 13px "Manrope", sans-serif; }
.next-step-card span { color: var(--muted); font-size: 10px; }
.next-step-card b { margin-top: auto; color: var(--blue); font-size: 10px; }
.activity-grid { grid-template-columns: minmax(0, 1fr); }
.compact-empty { min-height: 135px; }
.primary-button, .secondary-button { display: inline-flex; min-height: 43px; align-items: center; justify-content: center; gap: 10px; padding: 10px 17px; border: 1px solid transparent; border-radius: 999px; font-size: 12px; font-weight: 800; cursor: pointer; transition: transform .22s, background .22s, box-shadow .22s; }
.primary-button { background: var(--teal); color: #fff; box-shadow: 0 8px 20px rgba(8,145,168,.17); }
.primary-button:hover { transform: translateY(-2px); background: var(--blue); box-shadow: 0 11px 24px rgba(8,127,168,.2); }
.secondary-button { border-color: #cce5f0; background: #fff; color: var(--blue); }
.secondary-button:hover { transform: translateY(-2px); background: var(--pale); }
.dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 17px; margin-top: 19px; }
.panel { min-width: 0; margin-top: 19px; padding: 22px; border: 1px solid var(--border); border-radius: 17px; background: #fff; box-shadow: 0 6px 22px rgba(11,69,109,.035); }
.dashboard-grid .panel { margin-top: 0; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 16px; }
.panel-heading .eyebrow { margin-bottom: 4px; }
.panel-heading h2 { font: 700 17px/1.3 "Manrope", sans-serif; }
.panel-icon { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; border-radius: 13px; background: var(--sky); color: var(--teal); font-size: 22px; }
.empty-state { display: flex; min-height: 172px; flex-direction: column; align-items: center; justify-content: center; padding: 18px; border: 1px dashed #cfe3ed; border-radius: 13px; background: linear-gradient(145deg, #fbfeff, #f7fcff); text-align: center; }
.empty-state-icon { display: grid; width: 39px; height: 39px; margin-bottom: 9px; place-items: center; border-radius: 50%; background: #e8f7fb; color: var(--teal); font-size: 23px; }
.empty-state h3 { margin-bottom: 4px; font: 700 13px "Manrope", sans-serif; }
.empty-state p { max-width: 420px; color: var(--muted); font-size: 11px; line-height: 1.65; }
.empty-state .secondary-button { margin-top: 14px; }
.privacy-banner { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding: 14px 17px; border: 1px solid #d5edf6; border-radius: 14px; background: linear-gradient(110deg, #f0faff, #fff); color: #52728a; font-size: 12px; }
.privacy-icon { display: grid; width: 34px; height: 34px; flex: 0 0 34px; place-items: center; border-radius: 11px; background: #e2f6fb; color: var(--teal); font-size: 20px; }
.privacy-banner strong { color: var(--navy); }
.preview-toggle { display: flex; align-items: flex-start; gap: 9px; margin-top: 15px; color: var(--navy); font-size: 11px; font-weight: 700; cursor: pointer; }
.preview-toggle input, .check-row input { width: 16px; height: 16px; flex: 0 0 16px; accent-color: var(--teal); }
.field-hint { margin-top: 7px; color: var(--muted); font-size: 10px; }
.demo-note { margin-top: 13px; padding: 10px 12px; border-radius: 10px; background: #f2f9fc; color: #5b778a; font-size: 10px; line-height: 1.6; }
.trend-preview { margin-top: 8px; }
.trend-chart { display: flex; height: 115px; align-items: flex-end; justify-content: space-around; gap: 8px; padding: 14px 7px 0; border-bottom: 1px solid var(--border); }
.trend-day { display: flex; height: 100%; flex: 1; flex-direction: column; align-items: center; justify-content: flex-end; gap: 5px; }
.trend-day small { color: var(--muted); font-size: 9px; }
.trend-bar { display: block; width: min(22px, 70%); min-height: 13px; border-radius: 7px 7px 2px 2px; background: linear-gradient(180deg, #5ac2cb, #0d91ad); animation: bar-rise .5s ease both; transform-origin: bottom; }
.bar-one { height: 67%; }.bar-two { height: 76%; }.bar-three { height: 43%; }.bar-four { height: 58%; }.bar-five { height: 80%; }.bar-six { height: 71%; }.bar-seven { height: 87%; }
@keyframes bar-rise { from { transform: scaleY(.1); } to { transform: scaleY(1); } }
.chart-caption { margin-top: 8px; color: var(--muted); font-size: 9px; text-align: center; }
.permission-row { display: flex; align-items: center; gap: 12px; padding: 15px 0; border-top: 1px solid #edf4f8; }
.permission-symbol { display: grid; width: 32px; height: 32px; flex: 0 0 32px; place-items: center; border-radius: 11px; background: #e8f7fb; color: var(--teal); font-weight: 800; }
.permission-row>div { min-width: 0; flex: 1; }
.permission-row strong { color: var(--navy); font-size: 12px; }
.permission-row p { margin-top: 3px; color: var(--muted); font-size: 10px; }
.status-pill { flex: 0 0 auto; padding: 5px 9px; border-radius: 99px; background: #eef5f8; color: #607c8e; font-size: 9px; font-weight: 800; }
.private-pill { background: #eaf7f2; color: #34866e; }
.guidance-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
.family-chat-panel { display: grid; gap: 15px; }
.family-chat-panel .panel-heading { align-items: center; }
.family-chat-intro { max-width: 760px; color: var(--muted); font-size: 12px; }
.family-chat-prompts { display: flex; flex-wrap: wrap; gap: 8px; }
.chat-prompt { min-height: 36px; padding: 7px 12px; border: 1px solid #cfe8f1; border-radius: 999px; background: #f5fbfd; color: #43687e; font-size: 11px; font-weight: 600; text-align: left; cursor: pointer; transition: background .2s, border-color .2s, transform .2s; }
.chat-prompt:hover { transform: translateY(-1px); border-color: #9fd5e3; background: #eaf8fb; }
.family-chat-transcript { display: grid; align-content: start; gap: 12px; min-height: 165px; max-height: 360px; overflow-y: auto; padding: 16px; border: 1px solid var(--border); border-radius: 15px; background: linear-gradient(145deg, #f7fcff, #f1f9fb); scroll-behavior: smooth; }
.family-chat-message { width: fit-content; max-width: min(82%, 720px); padding: 12px 15px; border: 1px solid #dcecf5; border-radius: 15px 15px 15px 4px; background: #fff; box-shadow: 0 4px 14px rgba(11,69,109,.045); }
.family-chat-message.user-message { justify-self: end; border-color: #bfe9e7; border-radius: 15px 15px 4px 15px; background: linear-gradient(135deg, #e9f8fb, #e7f7f3); }
.chat-speaker { display: block; margin-bottom: 4px; color: var(--blue); font-size: 9px; font-weight: 800; letter-spacing: .3px; }
.family-chat-message p { color: #47677b; font-size: 12px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.family-chat-loading { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 11px; }
.typing-dots { display: inline-flex; gap: 4px; align-items: center; }
.typing-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); animation: typing-pulse .9s ease-in-out infinite alternate; }
.typing-dots i:nth-child(2) { animation-delay: .18s; }.typing-dots i:nth-child(3) { animation-delay: .36s; }
@keyframes typing-pulse { to { opacity: .35; transform: translateY(-3px); } }
.family-chat-error { color: #a44747; font-size: 11px; }
.family-chat-compose { display: flex; align-items: flex-end; gap: 10px; }
.family-chat-compose textarea { min-width: 0; min-height: 48px; max-height: 150px; flex: 1; resize: vertical; padding: 11px 13px; border: 1px solid #cfe1eb; border-radius: 13px; background: #fff; color: var(--text); font: inherit; font-size: 12px; }
.family-chat-compose textarea:focus { border-color: #73c4d5; outline: 3px solid rgba(121,207,226,.28); }
.family-chat-compose button:disabled, .chat-reset-button:disabled { cursor: wait; opacity: .62; }
.chat-safety-note { padding: 11px 13px; border-left: 3px solid #77bfd0; border-radius: 0 9px 9px 0; background: #f1f9fb; color: #5c7789; font-size: 10px; }
.support-card { min-height: 185px; padding: 21px; border: 1px solid var(--border); border-radius: 17px; background: #fff; box-shadow: 0 6px 22px rgba(11,69,109,.035); transition: transform .25s, box-shadow .25s, border-color .25s; }
.support-card:hover { transform: translateY(-4px); border-color: #b5e6f5; box-shadow: var(--shadow); }
.support-icon { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 13px; background: #e2f6fd; color: var(--teal); font-size: 22px; }
.support-card h2 { margin: 13px 0 7px; font: 700 15px "Manrope", sans-serif; }
.support-card p { color: var(--muted); font-size: 11px; }
.support-card .example-phrase { margin-top: 10px; padding: 9px 10px; border-left: 2px solid var(--teal); border-radius: 0 8px 8px 0; background: #f4fbfd; color: #476b81; font-size: 10px; font-style: italic; }
.resource-list { overflow: hidden; border: 1px solid var(--border); border-radius: 13px; }
.resource-row { display: flex; align-items: center; gap: 13px; padding: 13px 15px; transition: background .2s; }
.resource-row + .resource-row { border-top: 1px solid #edf4f8; }
.resource-row:hover { background: #f6fcff; }
.resource-icon { display: grid; width: 39px; height: 39px; flex: 0 0 39px; place-items: center; border-radius: 12px; background: var(--sky); color: var(--teal); font-size: 21px; }
.resource-row>span:nth-child(2) { display: grid; gap: 2px; }
.resource-row strong { color: var(--navy); font-size: 12px; }
.resource-row small { color: var(--muted); font-size: 10px; }
.resource-arrow { margin-left: auto; color: var(--teal); font-size: 20px; }
.filter-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; }
.filter-button { min-height: 33px; padding: 6px 11px; border: 1px solid #d7e9f1; border-radius: 99px; background: #fff; color: #5d7b8f; font-size: 10px; font-weight: 700; cursor: pointer; transition: background .2s, border-color .2s, color .2s; }
.filter-button:hover, .filter-button.active { border-color: #b7e0ed; background: #e8f7fb; color: var(--blue); }
.resource-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
.education-card { padding: 15px; border: 1px solid var(--border); border-radius: 13px; background: linear-gradient(145deg, #fff, #fbfeff); }
.education-card h3 { margin: 0 0 6px; font: 700 13px "Manrope", sans-serif; }
.education-card>p:not(.eyebrow) { color: var(--muted); font-size: 10px; }
.education-card .eyebrow { margin-bottom: 5px; font-size: 8px; }
.education-card details { margin-top: 9px; padding-top: 8px; border-top: 1px solid #eaf2f6; }
.education-card summary { color: var(--blue); font-size: 10px; font-weight: 800; cursor: pointer; }
.education-card details p { margin-top: 7px; color: #52728a; font-size: 10px; }
.prompt-form { display: grid; gap: 8px; }
.prompt-controls { display: flex; flex-wrap: wrap; gap: 9px; }
.prompt-controls select { min-width: min(300px, 100%); flex: 1; min-height: 42px; padding: 9px 11px; border: 1px solid #d6e7ef; border-radius: 10px; background: #fff; color: var(--text); font-size: 12px; }
.prompt-response { margin-top: 12px; padding: 12px 14px; border-left: 3px solid var(--teal); border-radius: 0 10px 10px 0; background: #f1fafc; color: #476b81; font-size: 11px; }
.optional-label { margin-left: 4px; color: var(--muted); font-size: 9px; font-weight: 500; }
.form-field textarea { width: 100%; min-height: 76px; resize: vertical; padding: 10px 11px; border: 1px solid #d6e7ef; border-radius: 10px; background: #fff; color: var(--text); font: inherit; font-size: 12px; }
.form-field textarea::placeholder { color: #91a8b7; }
.sharing-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; margin: 0 0 15px; }
.sharing-summary p { padding: 10px 12px; border-radius: 10px; background: #f5fafc; color: var(--muted); font-size: 10px; }
.sharing-summary strong { color: var(--navy); }
.homepage-link { margin-top: 14px; }
.demo-action-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 13px; }
.therapist-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
.therapist-card { display: flex; align-items: flex-start; gap: 12px; padding: 16px; border: 1px solid var(--border); border-radius: 15px; background: #fff; box-shadow: 0 6px 20px rgba(11,69,109,.035); }
.therapist-initials { display: grid; width: 42px; height: 42px; flex: 0 0 42px; place-items: center; border-radius: 14px; background: #e1f5f8; color: var(--blue); font: 800 12px "Manrope", sans-serif; }
.initials-blue { background: #e8f0fc; color: #5276ab; }.initials-light { background: #e8f8f1; color: #38856f; }
.therapist-card h2 { margin: 1px 0 3px; font: 700 13px "Manrope", sans-serif; }
.therapist-card p { margin-top: 5px; color: var(--muted); font-size: 10px; }
.therapist-card .therapist-role { margin: 0; color: var(--teal); font-size: 9px; font-weight: 700; }
.request-panel>.section-description { margin: -7px 0 18px; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
.form-field { display: grid; align-content: start; gap: 6px; }
.form-field label, .field-label { color: var(--navy); font-size: 11px; font-weight: 700; }
.form-field input, .form-field select { width: 100%; min-height: 43px; padding: 9px 11px; border: 1px solid #d6e7ef; border-radius: 10px; background: #fff; color: var(--text); font-size: 12px; }
.form-field input::placeholder { color: #91a8b7; }
.form-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.form-feedback { color: #34866e; font-size: 11px; font-weight: 700; }
.full-field { grid-column: 1 / -1; }
.check-row { display: flex; align-items: center; gap: 9px; color: var(--muted) !important; font-weight: 500 !important; }
.role-link { margin-top: 17px; }
.safety-panel { display: flex; align-items: flex-start; gap: 16px; padding: 21px; border: 1px solid #f1ddc7; border-radius: 16px; background: #fffaf5; box-shadow: 0 8px 24px rgba(111,98,85,.04); }
.safety-symbol { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; border-radius: 50%; background: #fff0dd; color: #ad6a26; font-size: 20px; font-weight: 800; }
.safety-panel .eyebrow { color: #a76a31; }
.safety-panel h2 { font: 700 19px "Manrope", sans-serif; }
.safety-panel p:not(.eyebrow) { margin-top: 7px; color: #6f6255; font-size: 11px; }
.safety-panel .demo-note { color: #5b778a !important; font-weight: 700; }
.help-grid { margin-top: 17px; }
.page-footer { display: flex; align-items: center; gap: 7px; padding: 26px 2px 0; color: var(--muted); font-size: 11px; }
.page-footer>span:first-of-type { color: var(--teal); }
.demo-label { margin-left: auto; padding: 5px 9px; border-radius: 99px; background: #eaf5f9; color: #648397; font-size: 9px; font-weight: 800; }

@media (max-width: 1120px) {
  :root { --sidebar-width: 245px; }
  .portal-container { padding-inline: 27px; }
  .therapist-grid { grid-template-columns: 1fr; }
  .therapist-card { min-height: 0; }
  .connection-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 820px) {
  :root { --sidebar-width: 263px; }
  .sidebar { transform: translateX(-105%); transition: transform .25s ease; box-shadow: 12px 0 35px rgba(11,69,109,.12); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-overlay { position: fixed; inset: 0; z-index: 90; display: block; visibility: hidden; background: rgba(5,31,48,.42); opacity: 0; transition: opacity .2s, visibility .2s; }
  .sidebar-overlay.visible { visibility: visible; opacity: 1; }
  .main-content { margin-left: 0; }
  .menu-button { display: inline-grid; flex: 0 0 40px; place-items: center; }
  .topbar { justify-content: flex-start; padding-inline: 18px; }
  .breadcrumb { flex: 1; }
  .topbar-actions { margin-left: auto; }
  .portal-container { padding-inline: clamp(18px, 4vw, 34px); }
}
@media (max-width: 640px) {
  .topbar { min-height: 64px; gap: 11px; }
  .portal-badge { padding: 7px 8px; font-size: 8px; }
  .portal-container { padding-top: 23px; }
  .page-heading { align-items: stretch; flex-direction: column; gap: 11px; margin-bottom: 18px; }
  .page-heading > div { width: 100%; min-width: 0; max-width: 100%; }
  .page-heading h1 { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  .page-heading h1 { font-size: 27px; }
  .page-description { font-size: 12px; }
  .welcome-card { min-height: 0; padding: 22px; }
  .welcome-art { width: 67px; height: 67px; flex-basis: 67px; }
  .welcome-orb { width: 49px; height: 49px; font-size: 27px; }
  .welcome-card p:not(.eyebrow) { font-size: 11px; }
  .welcome-card h2 { font-size: 20px; }
  .dashboard-grid, .guidance-grid, .form-grid { grid-template-columns: 1fr; }
  .resource-card-grid { grid-template-columns: 1fr; }
  .next-step-grid { grid-template-columns: 1fr; }
  .sharing-summary { grid-template-columns: 1fr; }
  .dashboard-grid { gap: 13px; margin-top: 13px; }
  .panel { padding: 17px; }
  .full-field, .form-actions { grid-column: auto; }
  .form-actions { align-items: flex-start; flex-direction: column; }
  .permission-row { align-items: flex-start; flex-wrap: wrap; }
  .permission-row>div { flex-basis: calc(100% - 50px); }
  .permission-row .status-pill { margin-left: 44px; }
  .safety-panel { gap: 11px; padding: 16px; }
  .safety-symbol { width: 32px; height: 32px; flex-basis: 32px; }
  .privacy-banner { align-items: flex-start; padding: 12px; font-size: 10px; }
  .resource-row { gap: 10px; padding: 12px; }
  .resource-row small { max-width: 230px; }
  .page-footer { flex-wrap: wrap; }
  .family-chat-panel .panel-heading { align-items: flex-start; flex-direction: column; }
  .family-chat-message { max-width: 94%; }
  .family-chat-compose { align-items: stretch; flex-direction: column; }
  .family-chat-compose button { align-self: flex-start; }
}
@media (max-width: 390px) {
  .welcome-art { display: none; }
  .portal-container { padding-inline: 14px; }
  .topbar { padding-inline: 12px; }
  .breadcrumb { gap: 6px; font-size: 10px; }
  .portal-badge { gap: 6px; }
  .dashboard-grid .panel { padding: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
